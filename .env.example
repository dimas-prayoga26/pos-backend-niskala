PORT=8080
HOST=0.0.0.0
NODE_ENV=development
# localhost and private LAN origins on Vite ports are accepted automatically.
CORS_ORIGINS=http://api.pos.coffeeniskala.com,http://pos.coffeeniskala.com
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pos_system
DB_TIMEZONE=+07:00
TZ=Asia/Jakarta
JWT_SECRET=local-pos-dev-secret

# Realtime through Pusher Channels (all four set: Pusher; else Socket.IO on this server).
# PUSHER_CHANNEL must start with private-; use another one per environment.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap1
PUSHER_CHANNEL=private-pos
