PORT=8080
HOST=0.0.0.0
NODE_ENV=development
# localhost and private LAN origins on Vite ports are accepted automatically.
CORS_ORIGINS=http://api.pos.coffeeniskala.com,http://pos.coffeeniskala.com
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pos_system
DB_TIMEZONE=+07:00
TZ=Asia/Jakarta
JWT_SECRET=local-pos-dev-secret

# Realtime through Pusher Channels (all four set: Pusher; else Socket.IO on this server).
# PUSHER_CHANNEL must start with private-; use another one per environment.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap1
PUSHER_CHANNEL=private-pos
# Socket.IO is off while Pusher is set; on|off overrides that.
REALTIME_SOCKET_IO=

# Konsumsi Crew (order type Crew) opens at this hour, Jakarta time.
CREW_MEAL_START_HOUR=12

# Requests to /api per device a minute; wrong passwords per account in 15 minutes (0: no limit).
RATE_LIMIT_API_PER_MINUTE=1000
RATE_LIMIT_LOGIN_FAILURES=10
