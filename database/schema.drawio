        <mxCell id="title" value="&lt;b style=&quot;font-size:24px&quot;&gt;Skema Database â€” Restaurant POS&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;DB pos_system (MySQL 8) Â· 26 tabel, 39 relasi Â· dibuat 2026-10-28 dari struktur database&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="1100" height="64" as="geometry"/></mxCell>
