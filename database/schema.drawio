        <mxCell id="legend_keys" value="&lt;b&gt;PK&lt;/b&gt; primary key Â· &lt;b&gt;FK&lt;/b&gt; foreign key Â· &lt;b&gt;UQ&lt;/b&gt; unique&lt;br&gt;&lt;b&gt;U1&lt;/b&gt; = bagian dari UNIQUE KEY gabungan beberapa kolom&lt;br&gt;&lt;b&gt;NULL&lt;/b&gt; = kolom boleh kosong&lt;br&gt;Label garis = aksi &lt;b&gt;ON DELETE&lt;/b&gt; (CASCADE / RESTRICT / SET NULL)&lt;br&gt;Ujung bercabang = banyak (N) Â· garis tegak = satu (1) Â· lingkaran = boleh kosong" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacingLeft=10;" vertex="1" parent="legend"><mxGeometry y="154" width="430" height="120" as="geometry"/></mxCell>
        <mxCell id="notes" value="&lt;b&gt;Alur biaya (HPP)&lt;/b&gt;&lt;br&gt;â€¢ &lt;b&gt;stock_raw_items.unit_cost&lt;/b&gt; = harga per satuan bahan baku (rata-rata belanja)&lt;br&gt;â€¢ &lt;b&gt;recipes.cost&lt;/b&gt; = quantity Ã— unit_cost bahan baku (otomatis)&lt;br&gt;â€¢ &lt;b&gt;stock_semi_item_menus.cost&lt;/b&gt; = porsi Ã— unit_cost bahan setengah jadi&lt;br&gt;â€¢ &lt;b&gt;menu_item_prices.hpp_cost&lt;/b&gt; = Î£ recipes.cost + Î£ stock_semi_item_menus.cost&lt;br&gt;â€¢ &lt;b&gt;order_item_costs&lt;/b&gt; = salinan HPP per bahan saat terjual (tidak berubah)&lt;br&gt;â€¢ &lt;b&gt;history_stock_raw_purchase_items&lt;/b&gt;: stock_unit_cost &amp; stock_value_after = kondisi stok setelah belanja&lt;br&gt;&lt;b&gt;Bahan setengah jadi&lt;/b&gt; (stock_semi_items, mis. Nasi)&lt;br&gt;â€¢ &lt;b&gt;stock_semi_item_recipes&lt;/b&gt; = komposisi 1 resep (bahan baku)&lt;br&gt;â€¢ &lt;b&gt;stock_semi_item_productions&lt;/b&gt; = Catat Masak: porsi = berat hasil Ã· portion_size&lt;br&gt;â€¢ &lt;b&gt;stock_semi_item_production_items&lt;/b&gt; = bahan baku terpakai saat masak" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=6;fontSize=11;fillColor=default;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="3176" y="398" width="430" height="200" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
