        <mxCell id="edge_5" value="CASCADE" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;fontSize=10;labelBackgroundColor=default;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=10;endSize=10;" edge="1" parent="1" source="orders__id" target="order_items__order_id"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_6" value="CASCADE" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;fontSize=10;labelBackgroundColor=default;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=10;endSize=10;" edge="1" parent="1" source="order_items__id" target="order_item_costs__order_item_id"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="edge_7" value="SET NULL" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;fontSize=10;labelBackgroundColor=default;startArrow=ERzeroToOne;endArrow=ERmany;startFill=0;endFill=0;startSize=10;endSize=10;" edge="1" parent="1" source="stock_items__id" target="order_item_costs__stock_item_id"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note_1" value="&lt;b&gt;recipes&lt;/b&gt; = pivot menu_items ↔ stock_items&lt;br&gt;1 baris = 1 bahan dalam resep sebuah menu.&lt;br&gt;Menggantikan &lt;b&gt;menu_item_ingredients&lt;/b&gt; (data dipindah saat boot, tabel lama dihapus):&lt;br&gt;• &lt;b&gt;stock_item_id&lt;/b&gt;: NULL → NOT NULL, ON DELETE SET NULL → RESTRICT&lt;br&gt;• &lt;b&gt;size_name&lt;/b&gt; dihapus: baris ukuran pertama dilebur ke resep menu, ukuran lain dibuang&lt;br&gt;• UNIQUE (menu_item_id, stock_item_id)&lt;br&gt;• &lt;b&gt;ingredient_name&lt;/b&gt; dihapus → pakai stock_items.name&lt;br&gt;• &lt;b&gt;unit&lt;/b&gt; dihapus: quantity selalu dalam satuan stok (stock_items.unit); ganti satuan stok gr ↔ kg ikut menyesuaikan quantity&lt;br&gt;• &lt;b&gt;cost&lt;/b&gt; = quantity × stock_items.unit_cost; Σ cost per menu → menu_item_prices.hpp_cost&lt;br&gt;• Nama menu/bahan: VIEW &lt;b&gt;recipe_details&lt;/b&gt;" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fillColor=default;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="860" y="482" width="330" height="230" as="geometry"/></mxCell>
        <mxCell id="note_2" value="&lt;b&gt;menu_item_prices&lt;/b&gt; = harga, harga online, HPP, gross profit&lt;br&gt;1 baris per menu (UNIQUE menu_item_id); menu tidak lagi punya ukuran.&lt;br&gt;Menggantikan kolom harga di &lt;b&gt;menu_items&lt;/b&gt; + tabel &lt;b&gt;menu_item_sizes&lt;/b&gt; (menu berukuran memakai harga ukuran pertama).&lt;br&gt;• hpp_cost = Σ recipes.cost (otomatis), gross_profit = regular_price − hpp_cost&lt;br&gt;&lt;b&gt;Dihapus:&lt;/b&gt; menu_item_sizes, menu_item_variants (Hot/Cold), menu_seed_exclusions, order_items.size_name. order_items.variant tetap untuk label order lama." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fillColor=default;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1270" y="740" width="330" height="210" as="geometry"/></mxCell>
        <mxCell id="note_3" value="&lt;b&gt;Kenapa recipes langsung jadi pivot?&lt;/b&gt;&lt;br&gt;22 menu punya 21 kombinasi resep berbeda, jadi tabel master resep terpisah akan hampir 1:1 dengan menu. Takaran yang sama (CUP 1 pcs, ESPRESSO 8 gr) cukup diubah dengan satu UPDATE." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fillColor=default;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="378" width="330" height="104" as="geometry"/></mxCell>
        <mxCell id="note_4" value="&lt;b&gt;order_item_costs&lt;/b&gt; = rincian HPP per bahan saat menu terjual&lt;br&gt;• Dibekukan saat order dibuat: perubahan harga beli / resep tidak mengubahnya&lt;br&gt;• cost = quantity × unit_cost (per porsi); Σ cost = order_items.hpp_cost&lt;br&gt;• Bandingkan HPP antar bulan per bahan dari tabel ini" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;spacingTop=4;fontSize=11;fillColor=default;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="860" y="1024" width="330" height="124" as="geometry"/></mxCell>
        <mxCell id="title" value="&lt;b style=&quot;font-size:20px&quot;&gt;Skema Resep — Restaurant POS&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Diterapkan 2026-10-27: recipes = pivot menu_items ↔ stock_items · DB pos_system (MySQL 8)&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="800" height="56" as="geometry"/></mxCell>
        <mxCell id="legend" value="Keterangan" style="swimlane;startSize=26;html=1;fontStyle=1;align=left;spacingLeft=8;fillColor=default;strokeColor=#999999;swimlaneFillColor=default;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1680" y="120" width="330" height="266" as="geometry"/></mxCell>
        <mxCell id="legend_sw_0" value="" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="legend"><mxGeometry x="10" y="37" width="26" height="14" as="geometry"/></mxCell>
        <mxCell id="legend_tx_0" value="Tabel existing (tidak berubah)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="legend"><mxGeometry x="44" y="34" width="276" height="20" as="geometry"/></mxCell>
        <mxCell id="legend_sw_1" value="" style="rounded=0;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="legend"><mxGeometry x="10" y="61" width="26" height="14" as="geometry"/></mxCell>
        <mxCell id="legend_tx_1" value="Pivot recipes (rename + dirapikan)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="legend"><mxGeometry x="44" y="58" width="276" height="20" as="geometry"/></mxCell>
        <mxCell id="legend_sw_2" value="" style="rounded=0;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="legend"><mxGeometry x="10" y="85" width="26" height="14" as="geometry"/></mxCell>
        <mxCell id="legend_tx_2" value="Tabel baru" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="legend"><mxGeometry x="44" y="82" width="276" height="20" as="geometry"/></mxCell>
        <mxCell id="legend_sw_3" value="abc" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#2d7600;" vertex="1" parent="legend"><mxGeometry x="10" y="109" width="26" height="14" as="geometry"/></mxCell>
        <mxCell id="legend_tx_3" value="Kolom diubah" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="legend"><mxGeometry x="44" y="106" width="276" height="20" as="geometry"/></mxCell>
        <mxCell id="legend_sw_4" value="abc" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=8;fontColor=#b85450;" vertex="1" parent="legend"><mxGeometry x="10" y="133" width="26" height="14" as="geometry"/></mxCell>
        <mxCell id="legend_tx_4" value="Kolom dihapus" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="legend"><mxGeometry x="44" y="130" width="276" height="20" as="geometry"/></mxCell>
        <mxCell id="legend_keys" value="&lt;b&gt;PK&lt;/b&gt; primary key · &lt;b&gt;FK&lt;/b&gt; foreign key · &lt;b&gt;UQ&lt;/b&gt; unique&lt;br&gt;&lt;b&gt;U1&lt;/b&gt; = bagian dari UNIQUE KEY komposit&lt;br&gt;Label garis = aksi &lt;b&gt;ON DELETE&lt;/b&gt; (CASCADE / RESTRICT / SET NULL)&lt;br&gt;Ujung bercabang = banyak (N), ujung garis tegak = satu (1)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;spacingLeft=10;" vertex="1" parent="legend"><mxGeometry y="154" width="330" height="112" as="geometry"/></mxCell>
